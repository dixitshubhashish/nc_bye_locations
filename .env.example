WORKFLOW_LOGIN_USER=admin
WORKFLOW_LOGIN_PASSWORD=change-me
WORKFLOW_CONFIG=config/demo.json
BIGQUERY_PROJECT_ID=your-google-cloud-project
BIGQUERY_BRONZE_DATASET_ID=birdeye_bronze_listings
BIGQUERY_SILVER_DATASET_ID=birdeye_silver_listings
BIGQUERY_GOLD_DATASET_ID=birdeye_gold_listings
# Defaults to <project>.<bronze dataset>.listings. Later point this at a silver/gold view.
# REPORTING_LISTINGS_TABLE=your-google-cloud-project.birdeye_gold_listings.v_reporting_locations
# Local file path option:
GOOGLE_APPLICATION_CREDENTIALS=config/connections/service-account.json
# Render secret option: paste the complete service account JSON as one env var.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
